<script>

/* =========================
   LOADER
========================= */

window.addEventListener("load",()=>{

    setTimeout(()=>{

        const loader=document.getElementById("loader");

        loader.style.opacity="0";

        setTimeout(()=>{
            loader.style.display="none";
        },1000);

    },2800);

});


/* =========================
   STAR / PARTICLE SYSTEM
========================= */

const canvas=document.getElementById("space");
const ctx=canvas.getContext("2d");

let particles=[];

function resize(){

    canvas.width=window.innerWidth;
    canvas.height=window.innerHeight;

    particles=[];

    const count=window.innerWidth<600 ? 70 : 140;

    for(let i=0;i<count;i++){

        particles.push({

            x:Math.random()*canvas.width,

            y:Math.random()*canvas.height,

            r:Math.random()*1.4+.2,

            speed:Math.random()*.35+.05,

            drift:(Math.random()-.5)*.2

        });

    }

}

resize();

window.addEventListener("resize",resize);


function animate(){

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    particles.forEach(p=>{

        p.y+=p.speed;
        p.x+=p.drift;

        if(p.y>canvas.height)
            p.y=-5;

        if(p.x>canvas.width)
            p.x=0;

        if(p.x<0)
            p.x=canvas.width;

        ctx.beginPath();

        ctx.arc(
            p.x,
            p.y,
            p.r,
            0,
            Math.PI*2
        );

        ctx.fillStyle="rgba(130,220,255,.65)";
        ctx.fill();

    });

    requestAnimationFrame(animate);

}

animate();


/* =========================
   SMOOTH NAVIGATION
========================= */

function scrollToId(id){

    const element=document.getElementById(id);

    if(element){

        element.scrollIntoView({
            behavior:"smooth"
        });

    }

}


/* =========================
   TERMINAL
========================= */

const commands=[

    ["scan --reality","Reality coordinates unstable."],

    ["recover --fragments","7 fragments successfully located."],

    ["listen --signal","Unknown transmission detected."],

    ["locate --origin","Origin coordinates hidden."],

    ["decrypt --node","Encryption layer remains active."]

];

let commandIndex=0;


function runTerminal(){

    const command=
        document.getElementById("command");

    const result=
        document.getElementById("terminalResult");

    const current=
        commands[commandIndex];

    command.textContent="";
    result.textContent="";

    let i=0;

    const interval=setInterval(()=>{

        command.textContent+=current[0][i];

        i++;

        if(i>=current[0].length){

            clearInterval(interval);

            setTimeout(()=>{

                result.textContent=
                    "> "+current[1];

                commandIndex++;

                if(commandIndex>=commands.length)
                    commandIndex=0;

                setTimeout(runTerminal,1800);

            },500);

        }

    },50);

}

