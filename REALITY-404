    font-size:10px;
}

.file-icon{
    font-size:35px;
    margin:25px 0 18px;
}

.file h3{
    font-family:Orbitron;
    font-size:15px;
    margin-bottom:10px;
}

.file p{
    color:var(--muted);
    line-height:1.7;
    font-size:12px;
}

.file-lock{
    position:absolute;
    top:18px;
    right:18px;
    color:var(--red);
