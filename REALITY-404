<title>REALITY 404 — BLACK NODE</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;600;700;800;900&display=swap" rel="stylesheet">

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#02040a;
    --panel:rgba(9,13,23,.68);
    --line:rgba(255,255,255,.09);
    --text:#f4f7ff;
    --muted:#7f8aa3;
    --cyan:#00eaff;
    --violet:#8b5cf6;
    --red:#ff3158;
    --green:#37f59a;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--bg);
    color:var(--text);
    font-family:Inter,sans-serif;
    overflow-x:hidden;
}

body::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-5;
    background:
        radial-gradient(circle at 15% 20%,rgba(0,234,255,.10),transparent 25%),
        radial-gradient(circle at 85% 75%,rgba(139,92,246,.11),transparent 28%);
}

body::after{
    content:"";
    position:fixed;
    inset:0;
    pointer-events:none;
    z-index:100;
    opacity:.025;
    background:repeating-linear-gradient(
        0deg,
        transparent,
        transparent 3px,
        #fff 4px
    );
}

canvas{
    position:fixed;
    inset:0;
    width:100%;
    height:100%;
    z-index:-4;
}

/* LOADER */

#loader{
    position:fixed;
    inset:0;
    z-index:9999;
    display:flex;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    background:#010207;
    transition:1s ease;
}

.loader-title{
    font-family:Orbitron;
    font-size:clamp(25px,7vw,65px);
    font-weight:900;
    letter-spacing:7px;
}

.loader-title span{
    color:var(--cyan);
}

.loader-status{
    margin-top:18px;
    color:var(--muted);
    font-family:monospace;
    font-size:11px;
    letter-spacing:2px;
}

.loader-line{
    width:min(380px,75vw);
    height:3px;
    margin-top:25px;
    background:#111622;
    overflow:hidden;
}

.loader-fill{
    height:100%;
    width:0;
    background:linear-gradient(90deg,var(--cyan),var(--violet));
    animation:loading 2.7s forwards;
}

@keyframes loading{
    to{width:100%}
}

/* HEADER */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    padding:22px 6%;
    display:flex;
    justify-content:space-between;
    align-items:center;
    z-index:50;
    border-bottom:1px solid rgba(255,255,255,.03);
    backdrop-filter:blur(12px);
}

.logo{
    font-family:Orbitron;
    font-weight:900;
    letter-spacing:2px;
    cursor:pointer;
}

.logo span{
    color:var(--cyan);
}

.nav-status{
    display:flex;
    align-items:center;
    gap:9px;
    color:var(--muted);
    font-size:10px;
    letter-spacing:1.5px;
}

.status-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--green);
    box-shadow:0 0 14px var(--green);
}

/* HERO */

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:130px 6% 80px;
    text-align:center;
    position:relative;
}

.hero-content{
    max-width:1000px;
}

.badge{
    display:inline-flex;
    align-items:center;
    gap:8px;
    border:1px solid rgba(0,234,255,.2);
    background:rgba(0,234,255,.035);
    padding:9px 15px;
    border-radius:100px;
    color:var(--cyan);
    font-family:monospace;
    font-size:10px;
    letter-spacing:2px;
    margin-bottom:30px;
}

.badge i{
    width:6px;
    height:6px;
    background:var(--cyan);
    border-radius:50%;
    box-shadow:0 0 10px var(--cyan);
}

.hero h1{
    font-family:Orbitron;
    font-size:clamp(43px,9vw,105px);
    line-height:.94;
    font-weight:900;
    letter-spacing:-4px;
    position:relative;
}

.hero h1 span{
    color:transparent;
    -webkit-text-stroke:1px rgba(255,255,255,.55);
}

.hero h1::after{
    content:"REALITY NOT FOUND";
    position:absolute;
    left:0;
    right:0;
    top:0;
    color:var(--cyan);
    opacity:.18;
    transform:translate(3px,2px);
    animation:distort 2.5s infinite;
}

@keyframes distort{
    0%,90%,100%{clip-path:inset(0)}
    92%{clip-path:inset(20% 0 50% 0)}
    95%{clip-path:inset(60% 0 10% 0)}
}

.hero-text{
    max-width:650px;
    margin:28px auto 35px;
    color:var(--muted);
    line-height:1.9;
    font-size:14px;
}

.buttons{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:12px;
}

.btn{
    border:1px solid transparent;
    padding:15px 24px;
    border-radius:9px;
    font-family:Orbitron;
    font-size:10px;
    font-weight:700;
    letter-spacing:1.5px;
    cursor:pointer;
    transition:.25s;
}

.primary{
    background:var(--cyan);
    color:#020409;
    box-shadow:0 0 30px rgba(0,234,255,.14);
}

.primary:hover{
    transform:translateY(-3px);
    box-shadow:0 0 45px rgba(0,234,255,.35);
}

.secondary{
    background:rgba(255,255,255,.035);
    color:white;
    border-color:var(--line);
}

.secondary:hover{
    border-color:rgba(0,234,255,.35);
    transform:translateY(-3px);
}

/* SECTION */

section{
    padding:100px 6%;
}

.section-head{
    max-width:1100px;
    margin:0 auto 35px;
}

.section-label{
    color:var(--cyan);
    font-family:monospace;
    font-size:10px;
    letter-spacing:3px;
    margin-bottom:10px;
}

.section-title{
    font-family:Orbitron;
    font-size:clamp(25px,4vw,45px);
}

.section-title span{
    color:var(--cyan);
}

.section-description{
    color:var(--muted);
    margin-top:10px;
    font-size:13px;
}

/* MONITOR */

.monitor{
    max-width:1100px;
    margin:auto;
    display:grid;
    grid-template-columns:1.5fr 1fr;
    gap:18px;
}

.panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:20px;
    backdrop-filter:blur(20px);
    box-shadow:0 25px 80px rgba(0,0,0,.25);
}

.panel-head{
    padding:15px 20px;
    border-bottom:1px solid var(--line);
    display:flex;
    justify-content:space-between;
    color:var(--muted);
    font-family:monospace;
    font-size:10px;
}

.panel-body{
    padding:25px;
}

.big-number{
    font-family:Orbitron;
    font-size:48px;
    color:var(--cyan);
    font-weight:800;
}

.meter{
    height:5px;
    background:#121722;
    border-radius:20px;
    overflow:hidden;
    margin:15px 0 25px;
}

.meter span{
    display:block;
    height:100%;
    width:73%;
    background:linear-gradient(90deg,var(--cyan),var(--violet));
    animation:pulseMeter 3s infinite alternate;
}

@keyframes pulseMeter{
    to{width:81%}
}

.stats{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:12px;
}

.stat{
    padding:17px;
    border:1px solid var(--line);
    border-radius:12px;
    background:rgba(255,255,255,.025);
}

.stat small{
    color:var(--muted);
    display:block;
    font-size:10px;
    margin-bottom:7px;
}

.stat strong{
    font-family:Orbitron;
    font-size:16px;
}

/* TERMINAL */

.terminal{
    max-width:1100px;
    margin:auto;
    overflow:hidden;
}

.terminal-top{
    display:flex;
    align-items:center;
    gap:7px;
    padding:14px 18px;
    border-bottom:1px solid var(--line);
}

.terminal-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#333;
}

.terminal-name{
    margin-left:10px;
    font-family:monospace;
    font-size:10px;
    color:var(--muted);
}

.terminal-body{
    padding:25px;
    min-height:280px;
    font-family:monospace;
    font-size:12px;
    line-height:2;
}

.green{
    color:var(--green);
}

.cyan{
    color:var(--cyan);
}

.dim{
    color:#687188;
}

.cursor{
    display:inline-block;
    width:7px;
    height:15px;
    background:var(--cyan);
    vertical-align:middle;
    animation:blink 1s infinite;
}

@keyframes blink{
    50%{opacity:0}
}

/* FILES */

.files{
    max-width:1100px;
    margin:auto;
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.file{
