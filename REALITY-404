    text-align:center;
    padding:45px 25px;
    border:1px solid var(--line);
    border-radius:22px;
    background:var(--panel);
    backdrop-filter:blur(20px);
}

.puzzle-code{
    font-family:Orbitron;
    color:var(--cyan);
    font-size:clamp(25px,5vw,45px);
    letter-spacing:8px;
    margin:25px 0;
}

.input{
    width:min(350px,90%);
    padding:14px;
    border:1px solid var(--line);
    border-radius:8px;
    outline:none;
    background:#050810;
    color:white;
    text-align:center;
    font-family:monospace;
}

.input:focus{
    border-color:var(--cyan);
    box-shadow:0 0 20px rgba(0,234,255,.08);
}

.result{
    min-height:25px;
    margin-top:18px;
    font-family:monospace;
    font-size:11px;
}

/* FOOTER */

footer{
    padding:50px 6%;
    text-align:center;
    border-top:1px solid var(--line);
    color:var(--muted);
    font-size:11px;
    line-height:2;
}

footer strong{
    color:var(--cyan);
}

/* MODAL */

.modal{
    position:fixed;
    inset:0;
    z-index:500;
    background:rgba(0,0,0,.82);
    backdrop-filter:blur(14px);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.active{
    display:flex;
}

.modal-box{
    width:min(650px,100%);
    padding:35px;
    background:#070a12;
    border:1px solid rgba(0,234,255,.2);
    border-radius:20px;
    position:relative;
    box-shadow:0 30px 100px rgba(0,0,0,.6);
}

.modal-box h2{
    font-family:Orbitron;
    margin-bottom:18px;
}

.modal-box p{
    color:var(--muted);
    line-height:1.9;
    font-size:13px;
}

.close{
    position:absolute;
    right:20px;
    top:15px;
    cursor:pointer;
    color:var(--muted);
    font-size:25px;
}

/* MOBILE */

@media(max-width:800px){

    header{
        padding:18px 5%;
    }

    .nav-status{
        display:none;
    }

    section{
        padding:75px 5%;
    }

    .monitor{
        grid-template-columns:1fr;
    }

    .files{
        grid-template-columns:1fr;
    }

    .hero h1{
        letter-spacing:-2px;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

}

@media(max-width:430px){

    .stats{
        grid-template-columns:1fr;
    }

    .hero-text{
        font-size:13px;
    }

    .terminal-body{
        font-size:10px;
        padding:18px;
    }

}
</style>
</head>

